{
  "name": "puff-sticker-premium",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:vite": "vite",
    "build:vite": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build && node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "preview:vite": "vite preview",
    "optimize:live-blog-images": "node scripts/optimize-live-blog-images.mjs",
    "migration:normalize-wordpress": "node scripts/migration/normalize-wordpress-public.mjs",
    "migration:reconcile-wordpress": "node scripts/migration/reconcile-wordpress-public.mjs",
    "migration:validate-wordpress": "node scripts/migration/validate-wordpress-public.mjs",
    "verify": "node scripts/verify-build.mjs",
    "test:regression": "node scripts/run-regression.mjs",
    "test:regression:update": "node scripts/run-regression.mjs --update-snapshots=all",
    "test:regression:headed": "node scripts/run-regression.mjs --headed",
    "test:regression:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.7.0",
    "gsap": "3.15.0",
    "lenis": "1.3.25",
    "lucide-react": "1.28.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.3",
    "@vitejs/plugin-react": "6.0.5",
    "playwright-core": "1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
